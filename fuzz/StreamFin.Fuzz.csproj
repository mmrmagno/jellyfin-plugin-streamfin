<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JellyfinReferencePath Condition="'$(JellyfinReferencePath)' == ''">../.jellyfin</JellyfinReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/StreamFin.csproj" />
    <Reference Include="$(JellyfinReferencePath)/*.dll" />
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>
</Project>
